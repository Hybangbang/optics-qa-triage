# Reddit API: leave the approval flag false until Reddit approves the use case in writing.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:optics-qa-triage:v0.1.0 (by /u/your_username)
REDDIT_API_APPROVED=false
REDDIT_SUBREDDIT=Optics

# LLM: use a provider with no-training / zero-retention terms.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_STORE=false
LLM_TIMEOUT_SECONDS=60

# Email review. If SMTP is empty, review messages go to outbox/*.eml.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Hard retention limit: 1-48 hours. Keep at or below 48.
RETENTION_HOURS=48

# Local paths.
OPTICS_QA_DB=var/optics_qa.sqlite3
OPTICS_QA_OUTBOX=outbox
